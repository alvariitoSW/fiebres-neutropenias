505 0 obj
<< /K 2 /P 482 0 R /S /Span /Type /StructElem >>
endobj
506 0 obj
<< /ActualText (SIN MATAR NI MORIR) /K [ 3 ] /P 482 0 R /S /Span /Type /StructElem >>
endobj
507 0 obj
<< /ActualText (Cuando las cosas van mal, como a veces pasa,) /K [ 0 ] /P 483 0 R /S /Span /Type /StructElem >>
endobj
508 0 obj
<< /ActualText (cuando el camino se ponga cuesta arriba,) /K [ 1 ] /P 484 0 R /S /Span /Type /StructElem >>
endobj
509 0 obj
<< /ActualText (cuando tus recursos bajen y las deudas suban,) /K [ 2 ] /P 485 0 R /S /Span /Type /StructElem >>
endobj
510 0 obj
<< /ActualText <feff006300750061006e0064006f00200061006c00200073006f006e0072006500ed0072002c002000640065006200610073002000610068006f0067006100720020006c006100730020006c00e1006700720069006d00610073002c> /K [ 3 ] /P 486 0 R /S /Span /Type /StructElem >>
endobj
511 0 obj
<< /ActualText (cuando tus preocupaciones te tengan agobiado,) /K [ 4 ] /P 487 0 R /S /Span /Type /StructElem >>
endobj
512 0 obj
<< /ActualText (descansa, si te urge, pero no te rindas.) /K [ 5 ] /P 488 0 R /S /Span /Type /StructElem >>
endobj
513 0 obj
<< /ActualText (La vida es rara con sus idas y venidas,) /K [ 6 ] /P 489 0 R /S /Span /Type /StructElem >>
endobj
514 0 obj
<< /ActualText <feff0064006f006e006400650020006c0061007300200063006f006e00740072006100640069006300630069006f006e0065007300200073006f006e00200065006c002000700061006e002000640065002000630061006400610020006400ed0061002c> /K [ 7 ] /P 490 0 R /S /Span /Type /StructElem >>
endobj
515 0 obj
<< /ActualText (y si el fracaso, entonces, llama a tu puerta ) /K [ 8 ] /P 491 0 R /S /Span /Type /StructElem >>
endobj
516 0 obj
<< /ActualText <feff007900200074006500200069006e0076006900740061002000610020006d0069007200610072002000680061006300690061002000610074007200e10073002c0020006e006f0020006c0065002000640065007300200065006e00740072006100640061002c> /K [ 9 ] /P 492 0 R /S /Span /Type /StructElem >>
endobj
517 0 obj
<< /ActualText (lucha, mira hacia delante, no te rindas.) /K [ 10 ] /P 493 0 R /S /Span /Type /StructElem >>
endobj
518 0 obj
<< /ActualText (El triunfo puede estar al girar la esquina.) /K [ 11 ] /P 494 0 R /S /Span /Type /StructElem >>
endobj
519 0 obj
<< /ActualText <feff0045006c00200074007200690075006e0066006f00200065007300200065006c0020006600720061006300610073006f00200061006c002000720065007600e90073003b0020> /K [ 12 ] /P 495 0 R /S /Span /Type /StructElem >>
endobj
520 0 obj
<< /ActualText (es el matiz plateado de esa nube incierta) /K [ 13 ] /P 496 0 R /S /Span /Type /StructElem >>
endobj
521 0 obj
<< /ActualText <feff0071007500650020006e006f002000740065002000640065006a00610020007600650072002000730075002000630065007200630061006e00ed00612026> /K [ 14 ] /P 497 0 R /S /Span /Type /StructElem >>
endobj
522 0 obj
<< /ActualText (aunque lo tengas ya al alcance de la mano. ) /K [ 15 ] /P 498 0 R /S /Span /Type /StructElem >>
endobj
